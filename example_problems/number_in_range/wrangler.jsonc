{
  "name": "number-in-range",
  "main": "build/index.js",
  "compatibility_date": "2026-04-16",
  "workers_dev": false,
  "preview_urls": true,
  "build": {
    "command": "cargo install -q worker-build@0.8.7 --locked --root .worker-build && .worker-build/bin/worker-build --release"
  },
  "assets": {
    "directory": "public"
  }
}
